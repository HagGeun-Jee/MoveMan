generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  userId    String   @unique // 로그인 아이디
  password  String   // 암호화된 비밀번호
  name      String
  role      String   @default("ADMIN")
  level     Int      @default(1) // 사용자 레벨 (숫자가 높을수록 높은 권한)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuPermission {
  id        String   @id @default(cuid())
  menuPath  String   @unique // 메뉴 경로 (예: /items)
  menuName  String   // 메뉴명
  minLevel  Int      @default(1) // 접근 가능한 최소 레벨
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Estimate {
  id             String   @id // 견적식별코드 (예: P2609070001)
  movingType     String   // P: 포장이사, G: 일반이사, K: 보관이사 등
  customerName   String
  contact        String
  fromAddress    String
  toAddress      String
  estimateDate   DateTime // 견적일자
  movingDate     DateTime? // 이사일
  organizeDate   DateTime? // 정리일
  visitDate      DateTime? // 방문일정
  
  // JSON 문자열 필드 (SQLite에서는 String으로 저장 후 애플리케이션에서 파싱)
  cbmItems       String?  // 물품 기본 CBM 및 내부 짐 추가 CBM
  materials      String?  // 자재량 (박스, 바구니 등)
  assemblyItems  String?  // 분해/설치 품목
  environment    String?  // 차량, 인원, 층수, 사다리차, 엘리베이터 등
  paymentPlan    String?  // 계약금, 중도금, 잔금 등
  adminHistory   String?  // 수정 이력 (누가 언제 수정했는지)
  signature      String?  // 고객 서명 (base64 이미지 등)
  
  // 비용 관련
  movingCost     Int      @default(0)
  storageCost    Int      @default(0)
  storageDays    Int      @default(0)
  additionalCost Int      @default(0) // 거리, 사다리차 등 추가비용
  vat            Int      @default(0)
  totalAmount    Int      @default(0)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model LocationCategory {
  id        String         @id @default(cuid())
  name      String         @unique
  order     Int            @default(0)
  items     StandardItem[]
  createdAt DateTime       @default(now())
}

model StandardItem {
  id                 String   @id @default(cuid())
  locations          LocationCategory[]
  name               String
  spec               String   @default("")
  defaultCbm         Float
  defaultInnerCbm    Float
  createdAt          DateTime @default(now())

  @@unique([name, spec])
}

model VehicleMaster {
  id          String   @id @default(cuid())
  name        String   @unique
  defaultCost Int
  maxCbm      Float    @default(0)
  createdAt   DateTime @default(now())
}

model LaborMaster {
  id          String   @id @default(cuid())
  name        String   @unique
  defaultCost Int
  createdAt   DateTime @default(now())
}

model LadderTruckMaster {
  id          String   @id @default(cuid())
  floorName   String   // 층수 표시 (예: "2~5층", "6~7층")
  minFloor    Int      // 최소 층수
  maxFloor    Int      // 최대 층수
  cost1Ton    Int      @default(0) // 1톤 운임 (원)
  cost2_5Ton  Int      @default(0) // 2.5톤 운임 (원)
  cost5Ton    Int      @default(0) // 5톤 운임 (원)
  cost6Ton    Int      @default(0) // 6톤 운임 (원)
  cost7_5Ton  Int      @default(0) // 7.5톤 운임 (원)
  cost10Ton   Int      @default(0) // 10톤 운임 (원)
  note        String?  @default("") // 비고 (특이사항 등)
  order       Int      @default(0) // 정렬 순서
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 3-1. 외주 용차 운임 기준정보 마스터 (거리 구간별 x 차종/차형별 시세)
model CharteredTruckMaster {
  id              String   @id @default(cuid())
  distanceName    String   // 거리 구간명 (예: "시내 관내 (20km 이내)", "30km 이내")
  minDistanceKm   Int      // 최소 거리 (km)
  maxDistanceKm   Int      // 최대 거리 (km)
  cost1TonCargo   Int      @default(0) // 1톤 카고 운임 (원)
  cost1TonTop     Int      @default(0) // 1톤 탑차/윙바디(우천) 운임 (원)
  cost2_5TonCargo Int      @default(0) // 2.5톤 카고 운임 (원)
  cost2_5TonTop   Int      @default(0) // 2.5톤 탑차/윙바디(우천) 운임 (원)
  cost5TonCargo   Int      @default(0) // 5톤 카고 운임 (원)
  cost5TonTop     Int      @default(0) // 5톤 탑차/윙바디(우천) 운임 (원)
  note            String?  @default("") // 비고
  order           Int      @default(0) // 정렬 순서
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}


// 4. 원가 기준정보 마스터 (운전자수당, 장거리인건비, 식대, 유류비, 테이프단가, 목표마진율)
model CostStandardMaster {
  id                          String   @id @default("default_cost_standard")
  maleLaborCost               Int      @default(190000) // 남성 작업원 기본 일당 (190,000원)
  femaleLaborCost             Int      @default(170000) // 여성 작업원 기본 일당 (170,000원)
  driverAllowance             Int      @default(20000) // 운전자 추가 수당 (차량당 20,000원)
  tonnageAllowance6Ton        Int      @default(10000) // 6톤 투입 시 1인당 물량 추가 수당 (10,000원)
  tonnageAllowance7_5Ton      Int      @default(20000) // 7.5톤 투입 시 1인당 물량 추가 수당 (20,000원)
  tonnageAllowance10Ton       Int      @default(30000) // 10톤 이상 투입 시 1인당 물량 추가 수당 (30,000원)
  baseDistanceKm              Int      @default(40)    // 장거리 기준거리 (40km)
  distanceStepKm              Int      @default(40)    // 장거리 초과 단위거리 (40km)
  distanceAllowancePerPerson  Int      @default(10000) // 초과 단위당 1인당 추가 수당 (10,000원)
  mealCostPerPerson           Int      @default(12000) // 작업원 1인당 식대 (12,000원)
  fuelCostPerKm5Ton           Int      @default(500)   // 5톤 탑차 km당 유류비 (500원)
  fuelCostPerKm2_5Ton         Int      @default(350)   // 2.5톤 탑차 km당 유류비 (350원)
  fuelCostPerKm1Ton           Int      @default(250)   // 1톤 탑차 km당 유류비 (250원)
  tapeUnitPrice               Int      @default(2000)  // OPP 테이프 롤당 단가 (2,000원)
  tapeRolls1Ton               Int      @default(3)     // 1톤 권장 롤수 (3롤)
  tapeRolls2_5Ton             Int      @default(5)     // 2.5톤 권장 롤수 (5롤)
  tapeRolls5Ton               Int      @default(8)     // 5톤 권장 롤수 (8롤)
  defaultMarginRate           Float    @default(20.0)  // 기본 목표 마진율 (20.0%)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

// ==================== 자재 재고관리 모델 ====================

// 1. 자재 품목 마스터
model MaterialItem {
  id          String   @id @default(cuid())
  code        String   @unique // 자재코드 (예: MAT-001)
  name        String   // 자재명 (예: 단프라박스 대형, 이사용 바구니)
  category    String   @default("REUSABLE") // REUSABLE(회수용), CONSUMABLE(소모용), TOOL(도구/장비)
  unit        String   @default("개") // 단위 (개, 롤, 매 등)
  safetyStock Int      @default(0) // 안전재고 (최소 필요 수량)
  unitPrice   Int      @default(0) // 단가 (원)
  memo        String?  @default("") // 비고
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stocks        MaterialStock[]
  transferItems MaterialTransferItem[]
  auditItems    MaterialAuditItem[]
}

// 2. 재고 보관 위치 (창고 및 차량)
model InventoryLocation {
  id          String   @id @default(cuid())
  name        String   @unique // 위치명 (예: 본사 메인창고, 1호차 (5톤탑차))
  type        String   @default("WAREHOUSE") // WAREHOUSE(창고), VEHICLE(차량)
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  memo        String?  @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stocks          MaterialStock[]
  sourceTransfers MaterialTransfer[] @relation("SourceLocation")
  targetTransfers MaterialTransfer[] @relation("TargetLocation")
  audits          MaterialAudit[]
}

// 3. 위치별 자재 보유 재고 (Location x Item)
model MaterialStock {
  id          String            @id @default(cuid())
  locationId  String
  materialId  String
  quantity    Int               @default(0) // 현재 수량
  updatedAt   DateTime          @updatedAt

  location    InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  material    MaterialItem      @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([locationId, materialId])
}

// 4. 재고 이동(이고) 및 입출고 전표
model MaterialTransfer {
  id              String   @id @default(cuid())
  transferNo      String   @unique // 전표번호 (예: TR261013-0001)
  type            String   // TRANSFER(이고: 위치간 이동), IN(신규구매입고), OUT(폐기/손망실)
  sourceLocId     String?  // 출발 위치 (IN일 경우 null)
  targetLocId     String?  // 도착 위치 (OUT일 경우 null)
  adminName       String   // 작업자/담당자
  memo            String?  @default("")
  transferDate    DateTime @default(now())
  createdAt       DateTime @default(now())

  sourceLocation  InventoryLocation? @relation("SourceLocation", fields: [sourceLocId], references: [id], onDelete: SetNull)
  targetLocation  InventoryLocation? @relation("TargetLocation", fields: [targetLocId], references: [id], onDelete: SetNull)
  items           MaterialTransferItem[]
}

// 4-1. 전표 품목
model MaterialTransferItem {
  id          String           @id @default(cuid())
  transferId  String
  materialId  String
  quantity    Int              // 이동/입출고 수량

  transfer    MaterialTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  material    MaterialItem     @relation(fields: [materialId], references: [id], onDelete: Cascade)
}

// 5. 재고 실사 전표
model MaterialAudit {
  id          String            @id @default(cuid())
  auditNo     String            @unique // 실사번호 (예: AUD261013-0001)
  locationId  String            // 실사 대상 위치 (창고 또는 특정 차량)
  adminName   String            // 실사 진행자
  memo        String?           @default("")
  auditDate   DateTime          @default(now())
  createdAt   DateTime          @default(now())

  location    InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  items       MaterialAuditItem[]
}

// 5-1. 실사 품목 상세 (전산 수량 vs 현장 실사 수량)
model MaterialAuditItem {
  id          String        @id @default(cuid())
  auditId     String
  materialId  String
  systemQty   Int           // 실사 시점 전산 수량
  actualQty   Int           // 실제 카운트 수량
  diffQty     Int           // 차이 수량 (actualQty - systemQty)
  reason      String?       @default("") // 오차 사유

  audit       MaterialAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  material    MaterialItem  @relation(fields: [materialId], references: [id], onDelete: Cascade)
}

